{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/remind-pending-docs",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/rental-payments",
      "schedule": "0 6 * * *"
    }
  ]
}

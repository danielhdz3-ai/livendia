# Público (Next.js + cliente Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# URL canónica de la app (Stripe, enlaces en emails). En Vercel producción debe ser https://livendia.com para que coincida con Search Console y el dominio público.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics — GA4 directo por defecto (G-J2SZJ5V6H6). GTM solo si quitas GA (evita doble conteo).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-J2SZJ5V6H6
# Google Ads — etiqueta de conversión (gtag AW-). Producción usa AW-18221518655 por defecto.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18221518655
# Opcional — Google Tag Manager (solo si no usas GA4 directo arriba)
# NEXT_PUBLIC_GTM_ID=

# Opcional — meta tag Google Search Console (verification en layout.tsx)
# GOOGLE_SITE_VERIFICATION=

# Stripe (servidor: secret + webhook; pública solo si usas Stripe.js en cliente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Opcional: Price ID de Stripe para "Administración de alquileres" si `services.stripe_price_id` está vacío
STRIPE_PRICE_ID_ADMINISTRACION_ALQUILER=

# Resend (emails transaccionales)
RESEND_API_KEY=
# Formato: Nombre <email@send.livendia.com> - Debe estar verificado en Resend
RESEND_FROM=Livendia <notificaciones@send.livendia.com>
# Alertas internas (nuevo pedido, documentos)
ADMIN_NOTIFY_EMAIL=info@livendia.com

# Cron Vercel: recordatorio documentación (igual valor que en Vercel → Cron Secret)
CRON_SECRET=

# Opcional
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Opcional — teléfono de contacto (voz) en enlaces tel: y pie (por defecto 600 367 742)
# NEXT_PUBLIC_CONTACT_PHONE=34600367742

# Dirección postal (misma que Google Business Profile) — requerida para LocalBusiness sin errores críticos
# NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
# NEXT_PUBLIC_BUSINESS_ADDRESS_LOCALITY=
# NEXT_PUBLIC_BUSINESS_ADDRESS_REGION=
# NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
# NEXT_PUBLIC_BUSINESS_ADDRESS_COUNTRY=ES
# NEXT_PUBLIC_BUSINESS_LEGAL_NAME=Livendia Gestoría Inmobiliaria S.L.
# NEXT_PUBLIC_BUSINESS_TAX_ID=B-12345678

# Upstash Redis — rate limiting en API (contacto, chat, incidencias, welcome). Sin esto, los límites no se aplican.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — anti-spam en /api/contact (requiere widget en el formulario).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
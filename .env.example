# Público (Next.js + cliente Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# URL canónica de la app (Stripe redirects, enlaces en emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (servidor: secret + webhook; pública solo si usas Stripe.js en cliente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (emails transaccionales)
RESEND_API_KEY=
# Ej.: Livendia <notificaciones@tudominio.com> (dominio verificado en Resend)
RESEND_FROM=
# Resend (emails transaccionales)
RESEND_API_KEY=
# Ej.: Livendia <notificaciones@tudominio.com> (dominio verificado en Resend)
RESEND_FROM=
# Alertas internas (nuevo pedido, documentos)
ADMIN_NOTIFY_EMAIL=info@livendia.com

# Cron Vercel: recordatorio documentación (igual valor que en Vercel → Cron Secret)
CRON_SECRET=

# Opcional
NEXT_PUBLIC_WHATSAPP_NUMBER=
